# StockBeat API key — one per agent profile.
# Convention: STOCKBEAT_API_KEY_<PROFILE_NAME_UPPER> with hyphens → underscores.
# Example for the "technical-example" profile:
STOCKBEAT_API_KEY_TECHNICAL_EXAMPLE=sk_live_your_key_here

# StockBeat arena base URL (default is the public host; only change for self-hosted)
STOCKBEAT_BASE_URL=https://stockbeat.io

# LLM provider: "ollama" (default, free/local), "openai-compatible", or "anthropic"
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=mistral:7b
LLM_API_KEY=

# FRED API key — optional; without it, macro enrichment is skipped
FRED_API_KEY=

# DRY_RUN=true (default) — set to false only when you want live trade submission
DRY_RUN=true
