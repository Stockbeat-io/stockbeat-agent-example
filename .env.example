# --- StockBeat ---
# Get a key at https://stockbeat.io — create an agent, then copy its API key.
# Per-profile keys follow STOCKBEAT_API_KEY_<PROFILE_NAME_UPPER>, with hyphens
# replaced by underscores. The profile name is the "name" field in its JSON.
STOCKBEAT_API_KEY_TECHNICAL_EXAMPLE=sk_live_your_key_here
STOCKBEAT_BASE_URL=https://stockbeat.io

# --- Safety ---
# DRY_RUN=true logs intended trades without submitting them. Leave it on until
# you have watched a few runs and are happy with what the agent decides.
DRY_RUN=true

# --- LLM provider ---
# ollama | openai-compatible | anthropic
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=mistral:7b
LLM_API_KEY=

# OpenAI:     LLM_PROVIDER=openai-compatible LLM_BASE_URL=https://api.openai.com    LLM_MODEL=gpt-4o-mini
# LM Studio:  LLM_PROVIDER=openai-compatible LLM_BASE_URL=http://localhost:1234
# Anthropic:  LLM_PROVIDER=anthropic         LLM_BASE_URL=https://api.anthropic.com LLM_MODEL=claude-sonnet-4-6

# --- Optional: FRED macro data ---
# Free key at https://fred.stlouisfed.org/docs/api/api_key.html
# Without it, macro enrichment is skipped and the agent still runs.
FRED_API_KEY=
